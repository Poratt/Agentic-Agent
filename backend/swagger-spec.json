{
  "openapi": "3.0.0",
  "paths": {
    "/auth/register": {
      "post": {
        "description": "Creates a new user account. Required RegisterDto fields: fullName, email, password. Password must be at least 8 characters. This endpoint is public and does not require a token.",
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "Registration payload. Example: { \"fullName\": \"John Doe\", \"email\": \"user@example.com\", \"password\": \"secret1234\" }.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully. Returns ServiceResultContainer<UserResponseDto>.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResultResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "DTO validation failed."
          },
          "401": {
            "description": "Not applicable for this public endpoint."
          },
          "403": {
            "description": "Not applicable for this public endpoint."
          },
          "404": {
            "description": "Not applicable for this endpoint."
          },
          "500": {
            "description": "Unexpected server error."
          }
        },
        "summary": "Register a new user account",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "description": "Validates user credentials. On success, the service writes access and refresh tokens to HTTP-only cookies and returns ServiceResultContainer<UserResponseDto>. Role is numeric: 1 = Admin, 2 = User.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "Login credentials. Example: { \"email\": \"user@example.com\", \"password\": \"secret1234\" }.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful. Tokens are set as cookies by the service.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResultResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "DTO validation failed."
          },
          "401": {
            "description": "Invalid credentials."
          },
          "403": {
            "description": "Not applicable for this public endpoint."
          },
          "404": {
            "description": "Not applicable for this endpoint."
          },
          "500": {
            "description": "Unexpected server error."
          }
        },
        "summary": "Login with email and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "description": "JwtRefreshGuard reads the refresh token from the cookie or Authorization header. If valid, AuthService issues new tokens and returns ServiceResultContainer<UserResponseDto>.",
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "New access token issued. Updated tokens are set as cookies by the service.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResultResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request."
          },
          "401": {
            "description": "Refresh token is missing, expired, revoked, or does not match the stored hash."
          },
          "403": {
            "description": "Not applicable for this endpoint."
          },
          "404": {
            "description": "Not applicable for this endpoint."
          },
          "500": {
            "description": "Unexpected server error."
          }
        },
        "summary": "Refresh access token using refresh token",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Requires a valid access token. Clears the stored refresh token hash and removes auth cookies from the response.",
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Logout successful.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResultResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request."
          },
          "401": {
            "description": "Access token is missing, expired, or invalid."
          },
          "403": {
            "description": "Not applicable for this endpoint."
          },
          "404": {
            "description": "Not applicable for this endpoint."
          },
          "500": {
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Logout and invalidate session",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "description": "Reads req.user as populated by JwtAuthGuard. No database query is made. Role is numeric: 1 = Admin, 2 = User.",
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "ServiceResultContainer<JwtPayload> with sub, email, numeric role, iat, and exp.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JwtPayloadResultResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request."
          },
          "401": {
            "description": "Access token is missing, expired, or invalid."
          },
          "403": {
            "description": "Not applicable for this endpoint."
          },
          "404": {
            "description": "Not applicable for this endpoint."
          },
          "500": {
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get current authenticated user payload",
        "tags": [
          "auth"
        ]
      }
    },
    "/users": {
      "get": {
        "description": "Returns every user in the system with public fields only: id, email, fullName, numeric role, createdAt, updatedAt, lastLoginAt. Passwords and refresh token hashes are never returned.",
        "operationId": "UsersController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "ServiceResultContainer<UserResponseDto[]>.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersListResultResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired JWT token."
          },
          "500": {
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List all users",
        "tags": [
          "users"
        ]
      }
    },
    "/users/me": {
      "get": {
        "description": "Returns the JWT payload decoded by JwtAuthGuard. No database query is made. Role is numeric: 1 = Admin, 2 = User.",
        "operationId": "UsersController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "ServiceResultContainer<JwtPayload> with sub, email, numeric role, iat, and exp.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JwtPayloadResultResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired JWT token."
          },
          "500": {
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get current authenticated user payload",
        "tags": [
          "users"
        ]
      }
    },
    "/users/{id}": {
      "get": {
        "description": "Fetches one user by numeric id with public fields only. Use GET /users first to discover valid IDs.",
        "operationId": "UsersController_getById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Unique numeric user id. ParseIntPipe rejects non-numeric values.",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ServiceResultContainer<UserResponseDto>.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResultResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired JWT token."
          },
          "404": {
            "description": "No user found with the given id."
          },
          "500": {
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get user by id",
        "tags": [
          "users"
        ]
      },
      "patch": {
        "description": "Updates fullName and/or email for the user identified by :id. This endpoint intentionally does not accept role changes; use PATCH /users/:id/role for role updates.",
        "operationId": "UsersController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Numeric id of the user to update.",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Partial profile update. Example: { \"fullName\": \"New Name\" } or { \"email\": \"new@example.com\" }.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ServiceResultContainer<UserResponseDto> with the updated user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResultResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired JWT token."
          },
          "403": {
            "description": "Authenticated user is not an admin."
          },
          "404": {
            "description": "No user found with the given id."
          },
          "500": {
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update user profile fields",
        "tags": [
          "users"
        ]
      },
      "delete": {
        "description": "Hard-deletes the user record. This is irreversible and requires admin privileges.",
        "operationId": "UsersController_delete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Numeric id of the user to delete.",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deletion confirmed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteUserResultResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired JWT token."
          },
          "403": {
            "description": "Authenticated user is not an admin."
          },
          "404": {
            "description": "No user found with the given id."
          },
          "500": {
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Delete user permanently",
        "tags": [
          "users"
        ]
      }
    },
    "/users/{id}/role": {
      "patch": {
        "description": "Sets only the role field of the user identified by :id. Accepted numeric values: 1 = Admin, 2 = User. Other user fields must be updated through PATCH /users/:id.",
        "operationId": "UsersController_updateRole",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Numeric id of the user whose role will change.",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Role payload. Example: { \"role\": 1 } for Admin or { \"role\": 2 } for User.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRoleDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ServiceResultContainer<UserResponseDto> with the updated user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResultResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired JWT token."
          },
          "403": {
            "description": "Authenticated user is not an admin."
          },
          "404": {
            "description": "No user found with the given id."
          },
          "500": {
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Change user role",
        "tags": [
          "users"
        ]
      }
    },
    "/admin-agent/sessions": {
      "get": {
        "description": "Returns recent chat sessions owned by the authenticated user. Sessions from other users are never returned.",
        "operationId": "AdminAgentController_getSessions",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Optional maximum number of recent sessions to return.",
            "schema": {
              "minimum": 1,
              "example": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sessions retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get chat sessions for the authenticated user",
        "tags": [
          "Admin Agent"
        ]
      },
      "post": {
        "description": "Creates a new empty chat session owned by the authenticated user.",
        "operationId": "AdminAgentController_createSession",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Chat session created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create a new chat session",
        "tags": [
          "Admin Agent"
        ]
      }
    },
    "/admin-agent/sessions/{id}/messages": {
      "get": {
        "description": "Returns user and assistant messages for a session owned by the authenticated user. Internal tool messages are filtered out for normal history display.",
        "operationId": "AdminAgentController_getSessionMessages",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Numeric chat session id.",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Historical messages loaded successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatMessageResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get session message history",
        "tags": [
          "Admin Agent"
        ]
      }
    },
    "/admin-agent/sessions/{id}": {
      "delete": {
        "description": "Permanently deletes a session owned by the authenticated user. ChatMessage rows are cascade-deleted through the ChatMessage.session relation.",
        "operationId": "AdminAgentController_deleteSession",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Numeric chat session id to delete.",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Chat session deleted successfully."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Delete chat session",
        "tags": [
          "Admin Agent"
        ]
      }
    },
    "/admin-agent/query-stream": {
      "post": {
        "description": "Streams newline-delimited JSON objects over a text/event-stream response. Each line is an AgentStreamEventDto. Token events use { \"type\": \"token\", \"content\": \"...\" }. Step events use { \"type\": \"step\", \"icon\": \"...\", \"message\": \"...\" }. The stream is complete when the HTTP response ends.",
        "operationId": "AdminAgentController_streamChat",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRequestDto"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/AgentRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stream opened. Response body contains newline-delimited AgentStreamEventDto JSON objects.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentStreamEventDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Query Admin Agent as a streamed response",
        "tags": [
          "Admin Agent"
        ]
      }
    }
  },
  "info": {
    "title": "API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "John Doe",
            "description": "Full display name for the new account. Required - must be a non-empty string. This field is not required to be unique."
          },
          "email": {
            "type": "string",
            "example": "admin@admin.com",
            "format": "email",
            "description": "Email address for the new account. Required - must be a valid email format and must be unique."
          },
          "password": {
            "type": "string",
            "example": "admin1234",
            "minLength": 8,
            "description": "Password for the new account. Minimum 8 characters. Required - stored as a bcrypt hash and never persisted as plain text."
          }
        },
        "required": [
          "fullName",
          "email",
          "password"
        ]
      },
      "UserRole": {
        "type": "number",
        "enum": [
          1,
          2
        ],
        "description": "Numeric user role. 1 = Admin, 2 = User."
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Unique numeric user id.",
            "example": 1
          },
          "email": {
            "type": "string",
            "description": "User email address.",
            "example": "user@example.com"
          },
          "fullName": {
            "type": "string",
            "description": "Full display name of the user.",
            "example": "John Doe"
          },
          "role": {
            "description": "Numeric user role. 1 = Admin, 2 = User.",
            "example": 2,
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Timestamp when the user was created.",
            "example": "2026-05-12T10:00:00Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Timestamp when the user was last updated.",
            "example": "2026-05-12T11:00:00Z"
          },
          "lastLoginAt": {
            "format": "date-time",
            "type": "string",
            "description": "Timestamp of the user last successful login, or null if the user never logged in.",
            "example": "2026-05-20T10:00:00Z",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "role",
          "createdAt",
          "updatedAt",
          "lastLoginAt"
        ]
      },
      "UserResultResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the request succeeded.",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "Human-readable result message.",
            "example": "User retrieved successfully"
          },
          "result": {
            "description": "Public user response payload.",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserResponseDto"
              }
            ]
          }
        },
        "required": [
          "success",
          "message",
          "result"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@admin.com",
            "format": "email",
            "description": "Registered email address of the user. Must be a valid email format (user@domain.com). Case-insensitive - \"Admin@Admin.com\" and \"admin@admin.com\" are treated as the same."
          },
          "password": {
            "type": "string",
            "example": "admin1234",
            "minLength": 4,
            "description": "Account password. Minimum 4 characters for login validation. Sent over HTTPS; hashing and comparison are handled server-side. Returns 401 if this does not match the stored hash."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LogoutPayloadDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "True when logout completed.",
            "example": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "LogoutResultResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the request succeeded.",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "Human-readable result message.",
            "example": "Logged out successfully"
          },
          "result": {
            "description": "Logout result payload.",
            "allOf": [
              {
                "$ref": "#/components/schemas/LogoutPayloadDto"
              }
            ]
          }
        },
        "required": [
          "success",
          "message",
          "result"
        ]
      },
      "JwtPayloadResponseDto": {
        "type": "object",
        "properties": {
          "sub": {
            "type": "number",
            "description": "Authenticated user id from the JWT subject.",
            "example": 1
          },
          "email": {
            "type": "string",
            "description": "Authenticated user email from the JWT payload.",
            "example": "user@example.com"
          },
          "role": {
            "description": "Numeric user role from the JWT payload. 1 = Admin, 2 = User.",
            "example": 2,
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          },
          "iat": {
            "type": "number",
            "description": "JWT issued-at timestamp in seconds.",
            "example": 1770000000
          },
          "exp": {
            "type": "number",
            "description": "JWT expiry timestamp in seconds.",
            "example": 1770000900
          }
        },
        "required": [
          "sub",
          "email",
          "role",
          "iat",
          "exp"
        ]
      },
      "JwtPayloadResultResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the request succeeded.",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "Human-readable result message.",
            "example": "Current user retrieved successfully"
          },
          "result": {
            "description": "Decoded JWT payload.",
            "allOf": [
              {
                "$ref": "#/components/schemas/JwtPayloadResponseDto"
              }
            ]
          }
        },
        "required": [
          "success",
          "message",
          "result"
        ]
      },
      "UsersListResultResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the request succeeded.",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "Human-readable result message.",
            "example": "Users retrieved successfully"
          },
          "result": {
            "description": "Public user response list.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserResponseDto"
            }
          }
        },
        "required": [
          "success",
          "message",
          "result"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "John Updated",
            "description": "Full display name of the user. Optional - omit this field to leave the current value unchanged. Validation: if provided, must be a string and must not be empty."
          },
          "email": {
            "type": "string",
            "example": "updated@example.com",
            "format": "email",
            "description": "New email address for the user. Optional - omit to keep the current email. Validation: must be a valid email format if provided. Uniqueness is enforced by the service/database layer."
          }
        }
      },
      "DeleteUserPayloadDto": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "True when the user was deleted.",
            "example": true
          }
        },
        "required": [
          "deleted"
        ]
      },
      "DeleteUserResultResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the request succeeded.",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "Human-readable result message.",
            "example": "User deleted successfully"
          },
          "result": {
            "description": "Deletion result payload.",
            "allOf": [
              {
                "$ref": "#/components/schemas/DeleteUserPayloadDto"
              }
            ]
          }
        },
        "required": [
          "success",
          "message",
          "result"
        ]
      },
      "UpdateUserRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "example": 2,
            "description": "The new numeric role to assign to the user. Required - this DTO represents a role-only update. Accepted numeric values: 1 = Admin, 2 = User. Security note: use 1 with caution because it grants access to admin-only endpoints.",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "SessionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Unique numeric chat session id.",
            "example": 42
          },
          "userId": {
            "type": "number",
            "description": "Owner user id. Session endpoints only return sessions owned by the authenticated user.",
            "example": 1
          },
          "title": {
            "type": "string",
            "description": "Human-readable session title. Initially defaults to \"שיחה חדשה...\" and may be updated from the prompt.",
            "example": "Monthly sales report"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Timestamp when the session was created.",
            "example": "2026-05-12T10:00:00Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Timestamp when the session or one of its messages was last updated.",
            "example": "2026-05-12T11:00:00Z"
          }
        },
        "required": [
          "id",
          "userId",
          "title",
          "createdAt",
          "updatedAt"
        ]
      },
      "ChatMessageResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Unique numeric chat message id.",
            "example": 1001
          },
          "userId": {
            "type": "number",
            "description": "Owner user id. Message endpoints only return messages from sessions owned by the authenticated user.",
            "example": 1
          },
          "sessionId": {
            "type": "number",
            "description": "Parent chat session id. Messages are deleted when their session is deleted.",
            "example": 42,
            "nullable": true
          },
          "role": {
            "type": "string",
            "description": "Message role. \"user\" is the prompt, \"assistant\" is model output, and \"tool\" is an internal tool result.",
            "enum": [
              "user",
              "assistant",
              "tool"
            ],
            "example": "assistant"
          },
          "content": {
            "type": "string",
            "description": "Message body stored for the chat history.",
            "example": "Here is the answer..."
          },
          "toolCallId": {
            "type": "string",
            "description": "Tool call id for internal tool-result messages, or null for normal user/assistant messages.",
            "example": "call_abc123",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Timestamp when the message was created.",
            "example": "2026-05-12T10:00:00Z"
          }
        },
        "required": [
          "id",
          "userId",
          "sessionId",
          "role",
          "content",
          "toolCallId",
          "createdAt"
        ]
      },
      "AgentStreamEventDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Stream event kind. \"token\" carries model text; \"step\" carries tool progress metadata.",
            "enum": [
              "token",
              "step"
            ],
            "example": "token"
          },
          "content": {
            "type": "string",
            "description": "Model text chunk. Present on token events.",
            "example": "The current user list contains..."
          },
          "message": {
            "type": "string",
            "description": "Progress message for a tool step. Present on step events.",
            "example": "Fetching users..."
          },
          "icon": {
            "type": "string",
            "description": "UI icon key for a step event. Present on step events.",
            "example": "ph-check-circle"
          }
        },
        "required": [
          "type"
        ]
      },
      "AgentRequestDto": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "The user prompt that will be sent to the AI agent.",
            "example": "Write a short summary of the following text..."
          },
          "sessionId": {
            "type": "number",
            "description": "The specific chat session ID associated with this message thread.",
            "example": 42
          }
        },
        "required": [
          "prompt"
        ]
      }
    }
  }
}