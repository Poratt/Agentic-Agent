# Environment variables
.env
.env.local
.env.*.local
.env.development
.env.production          # Environment variables and sensitive passwords (MySQL etc.)

# Diagnostics and Testing
*.log               # System error and run logs
coverage/           # Code coverage reports (Testing)

# TypeScript Cache
*.tsbuildinfo       # TypeScript incremental compilation cache filestsconfig.tsbuildinfo

# Playwright MCP artifacts and logs
.playwright-mcp/
page-*
console-*

