{
  "printWidth": 100,
  "tabWidth": 4,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "auto",
  "htmlWhitespaceInsensitivity": "ignore",
  "singleAttributePerLine": false,
  "overrides": [
    {
      "files": [
        "*.html"
      ],
      "options": {
        "parser": "angular",
        "printWidth": 100,
        "htmlWhitespaceInsensitivity": "ignore",
        "singleAttributePerLine": false,
        "bracketSameLine": false
      }
    },
    {
      "files": [
        "*.css",
        "*.scss"
      ],
      "options": {
        "singleQuote": false,
        "printWidth": 100
      }
    },
    {
      "files": [
        "*.json"
      ],
      "options": {
        "printWidth": 80,
        "trailingComma": "none"
      }
    },
    {
      "files": [
        "*.md"
      ],
      "options": {
        "printWidth": 80,
        "proseWrap": "always"
      }
    }
  ]
}